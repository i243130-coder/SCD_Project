{
  "$defs": {
    "EvidenceItem": {
      "properties": {
        "card_id": {
          "title": "Card Id",
          "type": "string"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "source": {
          "enum": [
            "hackernews",
            "github",
            "producthunt",
            "yc",
            "reddit"
          ],
          "title": "Source",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "card_id",
        "quote",
        "source",
        "url",
        "retrieved_at"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "IdeaInput": {
      "properties": {
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "IdeaInput",
      "type": "object"
    },
    "StudentProfile": {
      "properties": {
        "compute": {
          "enum": [
            "laptop",
            "free_gpu",
            "paid"
          ],
          "title": "Compute",
          "type": "string"
        },
        "goal": {
          "enum": [
            "startup",
            "portfolio",
            "course_project"
          ],
          "title": "Goal",
          "type": "string"
        },
        "hours_per_week": {
          "maximum": 80,
          "minimum": 0,
          "title": "Hours Per Week",
          "type": "number"
        },
        "interests": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Interests",
          "type": "array"
        },
        "profile_version": {
          "default": 1,
          "title": "Profile Version",
          "type": "integer"
        },
        "skills": {
          "items": {
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        },
        "team_size": {
          "maximum": 6,
          "minimum": 1,
          "title": "Team Size",
          "type": "integer"
        },
        "user_id": {
          "title": "User Id",
          "type": "string"
        },
        "weeks_available": {
          "maximum": 52,
          "minimum": 1,
          "title": "Weeks Available",
          "type": "integer"
        }
      },
      "required": [
        "user_id",
        "skills",
        "hours_per_week",
        "weeks_available",
        "team_size",
        "compute",
        "goal"
      ],
      "title": "StudentProfile",
      "type": "object"
    }
  },
  "properties": {
    "dimension": {
      "enum": [
        "demand_pain",
        "competition",
        "differentiation",
        "feasibility",
        "risk",
        "learning"
      ],
      "title": "Dimension",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceItem"
      },
      "title": "Evidence",
      "type": "array"
    },
    "features": {
      "additionalProperties": {
        "type": "number"
      },
      "default": {},
      "title": "Features",
      "type": "object"
    },
    "idea": {
      "$ref": "#/$defs/IdeaInput"
    },
    "profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/StudentProfile"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rubric": {
      "title": "Rubric",
      "type": "string"
    }
  },
  "required": [
    "rubric",
    "dimension",
    "idea",
    "evidence"
  ],
  "title": "ScoreRequest",
  "type": "object"
}
